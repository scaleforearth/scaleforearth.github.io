---
interface Props {
  title: string;
  /** Optional line under the title. */
  lead?: string;
  eyebrow?: string;
}

const { title, lead, eyebrow } = Astro.props;
---

<section class="hero hero--page">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
