---
import { contact } from '../data/site';
---

<section class="section" id="contact">
  <div class="container narrow">
    <h2>{contact.heading}</h2>
    {contact.intro && <p class="section-intro">{contact.intro}</p>}

    <ul class="contact-list">
      <li>
        <span class="contact-label">Email</span>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </li>
      <li>
        <span class="contact-label">{contact.linkedin.label}</span>
        <a href={contact.linkedin.url} target="_blank" rel="noopener noreferrer">
          {contact.linkedin.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
        </a>
      </li>
      {
        contact.location && (
          <li>
            <span class="contact-label">Location</span>
            <span>{contact.location}</span>
          </li>
        )
      }
    </ul>
  </div>
</section>
